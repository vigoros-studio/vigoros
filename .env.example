# Supabase (hosting only; Vigoros Studio lives in the `studio` Postgres schema)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Models
ANTHROPIC_API_KEY=

# HQ access: comma-separated emails allowed to sign in
HQ_ALLOWED_EMAILS=

# Runtime
MODEL_ADAPTER=fake            # fake | anthropic. fake never calls a paid API.
COMPANY_DAILY_CAP_USD=5

# Bunni worker
BUNNI_ROOT=/Users/you/Desktop/bunni
PAID_JOBS_ENABLED=false
HIGGSFIELD_DAILY_CAP_CREDITS=0
