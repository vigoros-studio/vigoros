# Supabase (hosting only; the company lives in the `studio` Postgres schema)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Models
ANTHROPIC_API_KEY=

# HQ access: comma-separated emails allowed to sign in
HQ_ALLOWED_EMAILS=

# Runtime
MODEL_ADAPTER=fake            # fake | anthropic. fake never calls a paid API.
COMPANY_DAILY_CAP_USD=5

# Which company row this process serves (one database may hold several)
COMPANY_NAME=OneGoodArea

# OneGoodArea worker: the only process that calls the API, PostHog, or writes the outbox
OGA_MODE=sample               # sample | live. sample serves the committed 12 Oct 2026 pack; live needs OGA_API_KEY.
OGA_API_BASE=https://api.onegoodarea.com/v1
OGA_API_KEY=                  # an `engineering`-type key, read-only, never a customer quota
OGA_DOCS_ROOT=/Users/you/dev/vigoros/docs/oga
OGA_OUTBOX=/Users/you/dev/oga-outbox
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=257448
POSTHOG_API_KEY=              # personal API key with read scope; empty keeps the scoreboard in sample mode
