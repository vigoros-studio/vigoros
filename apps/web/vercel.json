{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@vigoros/web",
  "crons": [
    { "path": "/api/jobs/generate", "schedule": "5 1 * * *" },
    { "path": "/api/jobs/stats", "schedule": "0 3 * * *" }
  ]
}
