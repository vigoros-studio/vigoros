{
  "name": "@vigoros/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@vigoros/contracts": "workspace:*",
    "@vigoros/db": "workspace:*",
    "@vigoros/engine": "workspace:*",
    "@vigoros/org": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg-boss": "^12.37.0",
    "zod": "^4.1.0"
  },
  "devDependencies": { "tsx": "^4.23.0", "typescript": "^5.8.3", "vitest": "^3.1.0" }
}
